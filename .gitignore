# ============================================================
# Barq Wadih — Monorepo .gitignore
# Covers: Laravel (PHP), Next.js (Node), Flutter (Dart), Docker, IDE
# ============================================================

# ─────────────────────────────────────────
# OS Files
# ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ─────────────────────────────────────────
# IDE / Editor Files
# ─────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ─────────────────────────────────────────
# Environment Variables (all stacks)
# ─────────────────────────────────────────
.env
.env.local
.env.*.local
.env.docker
!.env.example
!.env.testing

# ─────────────────────────────────────────
# Laravel / PHP (backend/)
# ─────────────────────────────────────────
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/public/hot
backend/public/storage
backend/auth.json
backend/phpstan.neon
!backend/.env.example

# ─────────────────────────────────────────
# Next.js / Node (frontend/)
# ─────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.pnp
frontend/.pnp.js
frontend/.yarn/
frontend/coverage/
frontend/.turbo
frontend/next-env.d.ts

# ─────────────────────────────────────────
# Flutter / Dart (mobile/)
# ─────────────────────────────────────────
mobile/.dart_tool/
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.framework
mobile/ios/Flutter/engine/
mobile/ios/Runner/GeneratedPluginRegistrant.*
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/key.properties
mobile/*.iml
mobile/doc/api/

# ─────────────────────────────────────────
# Docker
# ─────────────────────────────────────────
docker-data/
*.log

# ─────────────────────────────────────────
# Misc
# ─────────────────────────────────────────
*.bak
*.tmp
*.pid
*.seed
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/storage/firebase-service-account.json
