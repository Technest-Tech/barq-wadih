rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Conversations ─────────────────────────────────────────────────────────
    // Only participants (identified by Firebase UID) can read or write.
    match /conversations/{conversationId} {

      // Participant check helper
      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participantUids;
      }

      function isParticipantOnCreate() {
        return request.auth != null
          && request.auth.uid in request.resource.data.participantUids;
      }

      allow read:   if isParticipant();
      allow create: if isParticipantOnCreate()
        && request.resource.data.keys().hasAll([
          'participantIds', 'participantUids', 'adId', 'adTitle'
        ]);
      allow update: if isParticipant();
      allow delete: if false; // Conversations are never deleted

      // ── Messages subcollection ───────────────────────────────────────────────
      match /messages/{messageId} {

        function conversationData() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function isMember() {
          return request.auth != null
            && request.auth.uid in conversationData().participantUids;
        }

        allow read:   if isMember();
        allow create: if isMember()
          && request.auth.uid == request.resource.data.senderUid
          && request.resource.data.keys().hasAll([
            'senderUid', 'senderId', 'text', 'type', 'isRead', 'createdAt'
          ])
          && request.resource.data.type in ['text', 'image'];
        allow update: if isMember()
          // Only allow marking as read (isRead: true, readAt: timestamp)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isRead', 'readAt']);
        allow delete: if false; // Messages are immutable
      }
    }
  }
}
