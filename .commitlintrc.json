{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [2, "always", [
      "backend",
      "frontend",
      "mobile",
      "infra",
      "docs",
      "deps"
    ]],
    "type-enum": [2, "always", [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "chore",
      "ci",
      "revert"
    ]],
    "subject-case": [2, "never", ["upper-case"]],
    "subject-empty": [2, "never"],
    "type-empty": [2, "never"]
  }
}
