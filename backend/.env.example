APP_NAME="Barq Wadih"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
# Public website root — used to build shareable links (e.g. profile @handles)
FRONTEND_URL=https://barqwadih.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (Docker MySQL) ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barq_wadih
DB_USERNAME=barq_user
DB_PASSWORD=<your_mysql_password>

# ── Session / Cache / Queue ──────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Set to 'do_spaces' for DigitalOcean Spaces, 'public' for local server storage
FILESYSTEM_DISK=do_spaces
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Meilisearch ──────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=<your_meilisearch_master_key>

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@barqwadih.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── DigitalOcean Spaces ───────────────────────────────────────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=barq-wadih-media
# S3-compatible API endpoint (no bucket name in URL)
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# Public base URL for file access (virtual-hosted style)
DO_SPACES_URL=https://barq-wadih-media.sgp1.cdn.digitaloceanspaces.com
OBJECT_STORAGE_CONNECT_TIMEOUT=10
OBJECT_STORAGE_REQUEST_TIMEOUT=30

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000

VITE_APP_NAME="${APP_NAME}"

# ── Snapchat Conversions API (server-side only) ──────────────────────────────
SNAPCHAT_APP_ID=<your_snap_app_id>
SNAPCHAT_CAPI_TOKEN=<your_snapchat_conversions_api_token>
SNAPCHAT_CAPI_ENDPOINT=https://tr.snapchat.com/v3
SNAPCHAT_EVENT_SOURCE_URL=https://barqwadih.com/app

# Startup update popup. Set published=true only AFTER the store release is live.
# Keep false during review or a partial rollout; native store checks still run.
APP_UPDATE_IOS_PUBLISHED=false
APP_UPDATE_IOS_VERSION=
APP_UPDATE_IOS_MINIMUM_OS=
APP_UPDATE_ANDROID_PUBLISHED=false
APP_UPDATE_ANDROID_VERSION=
APP_UPDATE_ANDROID_BUILD=
APP_UPDATE_ANDROID_MINIMUM_SDK=
